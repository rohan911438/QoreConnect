{
  "name": "qoreconnect",
  "private": true,
  "description": "QoreConnect: the migration layer for the migration year. MetaMask on QoreChain with a post-quantum root key.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build && pnpm -r --filter ./apps/** run build",
    "build:packages": "pnpm -r --filter ./packages/** run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter ./packages/** run test",
    "test:integration": "pnpm -r --filter ./packages/** run test:integration",
    "test:contracts": "cd contracts && forge test -vv",
    "dev:web": "pnpm --filter @qoreconnect/web dev",
    "dev:relayer": "pnpm --filter @qoreconnect/relayer-app dev",
    "dev:demo": "pnpm --filter @qoreconnect/demo-dapp dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.10.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.4"
  }
}
