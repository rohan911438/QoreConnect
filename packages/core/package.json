{
  "name": "@rohankumar4179/core",
  "version": "0.1.0",
  "description": "QoreConnect core: post-quantum root vault, QoreChain account management, EIP-1193 provider.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@cosmjs/proto-signing": "0.39.0",
    "@cosmjs/stargate": "0.39.0",
    "@noble/hashes": "^1.8.0",
    "@qorechain/pqc": "0.2.3",
    "@qorechain/sdk": "0.14.0",
    "viem": "2.58.2"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohan911438/QoreConnect.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/rohan911438/QoreConnect#readme",
  "bugs": {
    "url": "https://github.com/rohan911438/QoreConnect/issues"
  },
  "keywords": [
    "qorechain",
    "post-quantum",
    "ml-dsa",
    "metamask",
    "wagmi",
    "account-abstraction",
    "session-keys"
  ],
  "publishConfig": {
    "access": "public"
  }
}
