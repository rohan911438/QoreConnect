{
  "name": "@qoreconnect/core",
  "version": "0.0.0",
  "description": "QoreConnect core: post-quantum root vault, QoreChain account management, EIP-1193 provider.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --dir test/integration --passWithNoTests"
  },
  "dependencies": {
    "@cosmjs/proto-signing": "0.39.0",
    "@cosmjs/stargate": "0.39.0",
    "@noble/hashes": "^1.8.0",
    "@qorechain/pqc": "0.2.3",
    "@qorechain/sdk": "0.14.0",
    "viem": "2.58.2"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4"
  }
}
