{
  "name": "@qoreconnect/react",
  "version": "0.1.0",
  "description": "React UI for QoreConnect: onboarding, signing preview, approvals, honesty labels.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@qoreconnect/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "happy-dom": "^21.0.4",
    "@testing-library/react": "^16.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohan911438/QoreConnect.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/rohan911438/QoreConnect#readme",
  "bugs": {
    "url": "https://github.com/rohan911438/QoreConnect/issues"
  },
  "keywords": [
    "qorechain",
    "post-quantum",
    "ml-dsa",
    "metamask",
    "wagmi",
    "account-abstraction",
    "session-keys"
  ],
  "publishConfig": {
    "access": "public"
  }
}
