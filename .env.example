QORE_RPC=https://rpc-testnet.qore.host
QORE_EVM_RPC=https://evm-testnet.qore.host
QORE_CHAIN_ID=qorechain-diana
QORE_EVM_CHAIN_ID=9800

# Relayer secrets (never commit real values)
RELAYER_MNEMONIC=
SPONSOR_MNEMONIC=
SPONSOR_INDEX=0
RELAYER_INDEX=1
SPONSOR_AMOUNT_UQOR=240000
SPONSOR_PER_IP_PER_DAY=3
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_TOKEN=
RELAYER_PORT=8787
RELAYER_DB=./data/relayer.db

# Public URLs
NEXT_PUBLIC_RELAYER_URL=http://localhost:8787
VITE_RELAYER_URL=http://localhost:8787

# AI agent example
ANTHROPIC_API_KEY=

# Migration Meter (docs/migration-meter.md). 0 disables the indexer.
METER_INTERVAL_MS=900000
METER_SAMPLE_BLOCKS=200
METER_MAX_SENDERS=50
# Public base URL of this relayer, used in evidence links.
RELAYER_PUBLIC_URL=http://localhost:8787
